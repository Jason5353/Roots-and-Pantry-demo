---
import Layout from '../layouts/Layout.astro';
import Snap from '../components/Snap.astro';
import { snapshot } from '../lib';
import { producers } from '../data/producers.js';
---
<Layout title="For local producers" description="Reach local families at the moment they plan what to cook.">
  <main>
    <section class="hero">
      <div class="wrap">
        <div>
          <span class="local">🧑‍🌾 For independent food producers</span>
          <h1 style="margin-top:16px;font-size:clamp(40px,6vw,76px)">Reach local families <span class="l2">when they plan what to cook.</span></h1>
          <p class="lead" style="max-width:40ch">Families keep their recipes and shopping lists in Roots &amp; Pantry. When a recipe or list needs something you make, your exclusive offer appears right beside it, but only for families in your county.</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-red" href="/">See it as a family</a><a class="btn btn-ghost" href="#dash">Demo dashboard</a></div>
        </div>
        <div class="collage" style="height:420px">
          <Snap s={snapshot('farmers-market')} class="c1" eager />
          <Snap s={snapshot('christmas-cheese-scones')} class="c3" eager />
        </div>
      </div>
    </section>
    <section class="wrap pagebody">
      <h2 class="sec" style="margin-top:0">How it works</h2>
      <div class="steps3">
        <div class="step"><span class="n">1</span><h3>You give us an exclusive code</h3><p>For example FAMILY10 for 10% off. You choose the offer and how long it runs.</p></div>
        <div class="step"><span class="n">2</span><h3>We show it where it matters</h3><p>Next to recipe ingredients and shopping-list items that use your products, for families in your county (and neighbouring counties if you like).</p></div>
        <div class="step"><span class="n">3</span><h3>Families buy from you direct</h3><p>They tap through to your own online shop and use the code. You keep the customer and the sale.</p></div>
      </div>
      <div class="two" style="margin-top:28px">
        <div class="panel"><h2>Our promises</h2><ul>
          <li><b>Independent producers only.</b> No supermarkets or big brands.</li>
          <li><b>Local first.</b> Offers are shown by county.</li>
          <li><b>No family data shared.</b> You see totals, never who the families are.</li>
          <li><b>No adverts.</b> No paid placements and no pay-to-rank. Deals only appear next to the ingredients they match, and under-13 accounts see no deals at all.</li></ul></div>
        <div class="panel"><h2>Free to list</h2>
          <table class="pricing">
            <tr><th>Local producer listing</th><th>Free</th></tr>
            <tr><td colspan="2">Your code on matching ingredients and shopping lists, your card on the Local deals page, and the monthly dashboard.</td></tr>
          </table>
          <p style="color:var(--ink-soft);font-size:15px;margin:12px 0 0">Free for families and for producers while we prove the idea. No contract, no subscription, no commission.</p></div>
      </div>

      <div class="panel tip" id="tip">
        <div class="tip-text">
          <h2>Pay it forward: a £5 thank-you</h2>
          <p>Roots &amp; Pantry is run on goodwill. If it sends customers your way and you feel it's earned it, you can leave a one-off <b>£5 thank-you</b>. That's it.</p>
          <ul class="rules">
            <li><b>Entirely voluntary.</b> Your listing stays exactly the same whether you tip or not.</li>
            <li><b>No invoices, no reminders.</b> Tip whenever you think it's deserved, as often or as rarely as you like.</li>
            <li><b>It keeps the lights on</b>: hosting, and time spent signing up more local families.</li>
          </ul>
          <p><a class="btn btn-red" href="https://checkout.revolut.com/pay/c51d5484-e8aa-4fce-b923-56b73550cc74" target="_blank" rel="noopener noreferrer">Leave a £5 thank-you ↗</a></p>
          <p style="font-size:14px;color:var(--ink-soft);margin:0">Secure payment by card, Apple Pay or Google Pay through Revolut.</p>
        </div>
        <figure class="tip-qr"><img src="/tip-qr.svg" alt="QR code to leave a £5 thank-you via Revolut" width="200" height="200" loading="lazy" /><figcaption>Or scan with your phone</figcaption></figure>
      </div>

      <h2 class="sec" id="dash">Demo producer dashboard</h2>
      <div class="panel">
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <label for="dp"><b>Producer</b></label>
          <select id="dp" style="font:600 17px var(--display);border:2px solid var(--ink);border-radius:999px;padding:9px 14px;background:#fff;color:var(--ink)">{producers.map((p) => <option value={p.id}>{p.name}</option>)}</select>
          <span style="font-size:14px;color:var(--ink-soft)">Fictional producer · last 30 days · sample numbers plus your taps in this demo</span>
        </div>
        <div class="stats">
          <div class="stat"><small>Offer shown to families</small><strong id="st0">0</strong></div>
          <div class="stat"><small>Taps through to your shop</small><strong id="st1">0</strong></div>
          <div class="stat"><small>Code copied</small><strong id="st2">0</strong></div>
          <div class="stat"><small>Orders using your code</small><strong style="font-size:18px;line-height:1.2;display:block;margin-top:8px">From your own shop's records</strong></div>
        </div>
        <p style="font-size:15px;color:var(--ink-soft);margin:14px 0 0">Taps and copies are counted by the app. Orders are counted by the code in your own shop system, so you always know what you're getting.</p>
      </div>
      <div class="panel producer-cta">
        <div style="font-size:44px">🤝</div>
        <div style="flex:1;min-width:240px"><h2 style="margin:0 0 4px">Interested in the pilot?</h2><p style="margin:0;color:var(--ink-soft)">We're looking for local producers in Shropshire to try it out, free. Get in touch with Jason Lewis.</p></div>
        <div class="contact">
          <a class="btn btn-red" href="mailto:admin@bmscyberdefence.co.uk?subject=Roots%20%26%20Pantry%20pilot">✉️ admin@bmscyberdefence.co.uk</a>
          <a class="btn btn-ghost" href="tel:+447821453905">📞 07821 453 905</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
<script>
  import { load, producers } from '../scripts/store';
  const sel = document.getElementById('dp') as HTMLSelectElement;
  function draw() {
    const p = producers.find((x) => x.id === sel.value)!; const t = load().taps[p.id] ?? [0, 0, 0];
    [0, 1, 2].forEach((i) => (document.getElementById(`st${i}`)!.textContent = String((p.base[i] ?? 0) + t[i])));
  }
  sel.addEventListener('change', draw); document.addEventListener('demo:change', draw); draw();
</script>
